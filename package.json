{
  "name": "warzone-td",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "gauntlet": "vite build --ssr scripts/gauntlet.ts --outDir .bench --emptyOutDir && node .bench/gauntlet.js",
    "bot": "vite build --ssr scripts/bot.ts --outDir .bench --emptyOutDir && node .bench/bot.js",
    "probe": "vite build --ssr scripts/rangeprobe.ts --outDir .bench --emptyOutDir && node .bench/rangeprobe.js"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "playwright-core": "1.55",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
